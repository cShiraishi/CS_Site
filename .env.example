# ── Endereço público do site ───────────────────────────────────────
# Alimenta canonical, Open Graph, sitemap, robots e o JSON-LD.
# Se ficar vazio, a Vercel usa sozinha o domínio de produção do projeto.
# Preencha quando ligar um domínio próprio, ex.: https://carlosseiti.com
NEXT_PUBLIC_SITE_URL=

# ── Formulário de contato ──────────────────────────────────────────
# Sem a chave, o formulário funciona mas só registra o lead no log do servidor.
# Crie em https://resend.com/api-keys
RESEND_API_KEY=

# Para onde chegam as solicitações de avaliação
CONTATO_EMAIL=contato@carlosseiti.com

# Remetente. Enquanto o domínio não estiver verificado na Resend,
# mantenha o onboarding@resend.dev — ele só entrega para o e-mail da sua conta.
CONTATO_REMETENTE=Site CS <onboarding@resend.dev>

# ── Verificação de propriedade do site ─────────────────────────────
# Google Search Console → Adicionar propriedade → tag HTML (só o content)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
# Bing Webmaster Tools → Adicionar site → meta tag (só o content)
NEXT_PUBLIC_BING_VERIFICATION=

# ── Analytics sem cookies (opcional, escolha um) ───────────────────
# Nenhum dos dois usa cookie, então não exigem banner de consentimento.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_UMAMI_ID=
NEXT_PUBLIC_UMAMI_SRC=
