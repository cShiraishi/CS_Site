# Endereço público do site
NEXT_PUBLIC_SITE_URL=

# Supabase: autenticação sem senha e dados dos clientes
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua_chave_publicavel

# Formulários e envio de resultados por e-mail
RESEND_API_KEY=
CONTATO_EMAIL=contato@carlosseiti.com
CONTATO_REMETENTE=Site CS <onboarding@resend.dev>

# Pagamento — Mercado Pago (Checkout Pro: Pix, cartão e boleto)
# O access token e o segredo do webhook são do SERVIDOR: nunca prefixar com
# NEXT_PUBLIC_, ou vão ao navegador de todos os visitantes.
# Credenciais em: mercadopago.com.br/developers > Suas integrações > Credenciais
MERCADOPAGO_ACCESS_TOKEN=
# Painel > Webhooks > configurar notificações. Sem este segredo o webhook
# recusa tudo, de propósito: é ele que distingue uma notificação do Mercado
# Pago de um POST de qualquer pessoa que descubra o endereço.
MERCADOPAGO_WEBHOOK_SECRET=

# Supabase — chave de serviço, só para o webhook confirmar pedidos.
# Ignora todas as políticas de RLS. Nunca vai ao navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Geração das figuras da escala corporal (scripts/gerar-shapes.py)
# Só é usada em tempo de build de assets — o site em produção não a lê.
OPENAI_API_KEY=

# Verificação de propriedade do site
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# Analytics sem cookies (opcional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_UMAMI_ID=
NEXT_PUBLIC_UMAMI_SRC=
